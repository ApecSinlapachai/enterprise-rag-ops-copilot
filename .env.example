# Database (Local Docker pgvector or Supabase Free Tier)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_ops

# Gemini API (Free Tier)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=1536

# Security & Demo Guardrails
ADMIN_INGEST_TOKEN=change-me-local-admin-token
CORS_ORIGINS=http://localhost:3000,https://your-demo.vercel.app
RATE_LIMIT_PER_MIN=15
RATE_LIMIT_PER_DAY=60

# Retrieval & Groundedness Thresholds (Calibrated for L2-normalized gemini-embedding-001 @ 1536d)
MIN_VEC_SIMILARITY=0.58
MIN_FTS_RANK=0.08
MIN_LLM_CONFIDENCE=0.55
